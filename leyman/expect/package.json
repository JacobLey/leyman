{
  "name": "@leyman/expect",
  "version": "0.1.0",
  "description": "Chai's expect and assert with chai-as-promised registered, as one ESM import, so async assertions work in any test file without setup.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "leyman/expect"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/leyman/expect#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "chai",
    "chai-as-promised",
    "expect",
    "assert",
    "assertions",
    "testing",
    "mocha",
    "esm",
    "typescript"
  ],
  "sideEffects": true,
  "exports": {
    ".": "./dist/expect.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "dependencies": {
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "typescript": "catalog:"
  }
}
