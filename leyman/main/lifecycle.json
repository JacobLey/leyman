{
  "$schema": "../../apps/nx-lifecycle/out/schema.json",
  "stages": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "prepare": {
      "hooks": [
        "generate",
        "format"
      ],
      "dependsOn": [
        "install"
      ]
    },
    "check": {
      "hooks": [
        "lint"
      ],
      "dependsOn": [
        "^build",
        "prepare"
      ]
    },
    "build": {
      "hooks": [
        "pre",
        "run",
        "post"
      ],
      "dependsOn": [
        "^build",
        "prepare"
      ]
    },
    "test": {
      "hooks": [
        "reset",
        "run",
        "report"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "verify": {
      "dependsOn": [
        "check",
        "test"
      ]
    }
  },
  "bindings": {
    "barrelify": "prepare:generate",
    "update-ts-references": "prepare:generate",
    "biome": "prepare:format",
    "eslint": "check:lint",
    "delete-dist": "build:pre",
    "tsc": "build:run",
    "populate-files": "build:post",
    "coverage-reset": "test:reset",
    "mocha-unit-test": "test:run",
    "mocha-integration-test": "test:run",
    "vitest-unit-test": "test:run",
    "coverage-report": "test:report"
  }
}
