{
  "$schema": "../../apps/nx-lifecycle/out/schema.json",
  "stages": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "prepare": {
      "hooks": [
        "generate",
        "format"
      ],
      "dependsOn": [
        "install"
      ]
    },
    "check": {
      "hooks": [
        "lint"
      ],
      "dependsOn": [
        "^build",
        "prepare",
        "build"
      ]
    },
    "build": {
      "hooks": [
        "run",
        "post",
        "sync"
      ],
      "dependsOn": [
        "^build",
        "prepare"
      ]
    },
    "test": {
      "hooks": [
        "compile",
        "run",
        "report"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "verify": {
      "dependsOn": [
        "check",
        "test"
      ]
    }
  },
  "bindings": {
    "barrelify": "prepare:generate",
    "update-ts-references": "prepare:generate",
    "schema-snapshot": "prepare:generate",
    "genever": "prepare:generate",
    "biome": "prepare:format",
    "gofmt": "prepare:format",
    "tofu-fmt": "prepare:format",
    "eslint": "check:lint",
    "check-package": "check:lint",
    "drizzle-kit-check": "check:lint",
    "go-vet": "check:lint",
    "tofu-validate": "check:lint",
    "tsc": "build:run",
    "vitepress-build": "build:run",
    "populate-files": "build:post",
    "tsc-test": "test:compile",
    "playwright-install": "test:compile",
    "mocha-unit-test": "test:run",
    "mocha-integration-test": "test:run",
    "vitest-unit-test": "test:run",
    "go-test": "test:run",
    "coverage-report": "test:report",
    "go-coverage-report": "test:report",
    "sync-injected": "build:sync"
  }
}
