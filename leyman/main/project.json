{
  "$schema": "../../leyman/main/node_modules/nx/schemas/project-schema.json",
  "name": "@leyman/main",
  "targets": {
    "biome": {},
    "check-fork-manifest": {},
    "check-parity": {},
    "check-workspace-dependencies": {},
    "eslint": {
      "inputs": [
        "eslint-input",
        "ts-source",
        "{projectRoot}/test/**/*",
        "package-files",
        "dependency-builds",
        "^dependency-files",
        "{projectRoot}/scripts/**/*"
      ]
    },
    "nx-plugin-targets": {
      "executor": "@leyman/nx-plugin:targets",
      "options": {
        "config": "leyman/main/nx-plugin.json"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "lifecycle": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "lifecycle"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build",
        "nx-plugin-targets"
      ]
    },
    "fork-manifest-audit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ./scripts/audit-fork-manifest.mjs"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      }
    },
    "install:_": {},
    "install": {},
    "prepare:_": {},
    "prepare:generate": {},
    "prepare:format": {},
    "prepare": {},
    "check:_": {},
    "check:lint": {},
    "check": {},
    "build:_": {},
    "build:run": {},
    "build:post": {},
    "build:sync": {},
    "build": {},
    "test:_": {},
    "test:compile": {},
    "test:run": {},
    "test:report": {},
    "test": {},
    "verify:_": {},
    "verify": {}
  }
}
