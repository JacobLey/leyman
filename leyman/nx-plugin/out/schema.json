    "configs": {
      "type": "object",
      "description": "Paths of the shared configs, relative to each project",
      "additionalProperties": false,
      "properties": {
        "swc": {
          "type": "string",
          "default": "node_modules/@leyman/configs/swcrc.jsonc"
        },
        "c8": {
          "type": "string",
          "default": "node_modules/@leyman/configs/c8rc.json"
        },
        "vitest": {
          "type": "string",
          "default": "node_modules/@leyman/configs/vitest.config.js"
        }
      }
    },
    "scripts": {
      "type": "string",
      "description": "Directory to run the plugin's scripts from, instead of the package's bins (`leyman-swc-compile`...)"
    },
    "coverage": {
      "type": "object",
      "description": "Coverage thresholds `coverage-report` passes to c8, over the c8 config's",
      "additionalProperties": false,
      "properties": {
        "branches": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "functions": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lines": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "statements": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "checkPackage": {
      "type": "object",
      "description": "Options of `check-package`",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "description": "The module resolutions every entry point must work under",
          "enum": [
            "esm-only",
            "node16",
            "strict"
          ]
        },
        "floorTsconfig": {
          "oneOf": [
            {
              "type": "string",
              "default": "@leyman/configs/tsconfig.node-{major}.json",
              "description": "The config a package's `tsconfig.json` must extend, with `{major}` for its support floor"
            },
            {
              "description": "Not checked",
              "const": false
            }
          ]
        },
        "inputs": {
          "type": "array",
          "description": "What a change of check-package itself is hashed by",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "A file pattern, or the name of a named input"
              },
              {
                "type": "object",
                "description": "An input object, such as `{ \"externalDependencies\": [\"pkg\"] }`"
              }
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "What changes of the shared tools are hashed by",
      "additionalProperties": false,
      "properties": {
        "configs": {
          "type": "array",
