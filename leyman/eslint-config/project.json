      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration && c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none eslint . --cache --cache-strategy content --color"
