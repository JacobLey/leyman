{
  "name": "@leyman/eslint-config",
  "version": "0.2.0",
  "description": "An ESLint flat config for TypeScript ESM packages with nearly every rule on and a reason given for each exception, generated from each package's package.json.",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "leyman/eslint-config"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/leyman/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "flat-config",
    "typescript",
    "typescript-eslint",
    "esm",
    "strict",
    "opinionated",
    "biome"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/eslint-config.js",
    "./package-json-schema": "./dist/lib/package-json-schema.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "skills"
  ],
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:eslint-rules",
    "@eslint/js": "catalog:eslint-rules",
    "@typescript-eslint/eslint-plugin": "catalog:eslint-rules",
    "@typescript-eslint/parser": "catalog:eslint-rules",
    "@typescript-eslint/utils": "catalog:eslint-rules",
    "ajv": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:eslint-rules",
    "eslint-plugin-jsdoc": "catalog:eslint-rules",
    "eslint-plugin-jsx-a11y": "catalog:eslint-rules",
    "eslint-plugin-n": "catalog:eslint-rules",
    "eslint-plugin-react": "catalog:eslint-rules",
    "eslint-plugin-react-hooks": "catalog:eslint-rules",
    "eslint-plugin-regexp": "catalog:eslint-rules",
    "eslint-plugin-sonarjs": "catalog:eslint-rules",
    "eslint-plugin-unicorn": "catalog:eslint-rules",
    "globals": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/chai": "catalog:",
    "@types/eslint": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-24",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "chai": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
