{
  "biome.lsp.bin": "leyman/main/node_modules/.bin/biome",

  "coverage-gutters.coverageBaseDir": ".coverage/project/**",

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,

  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.runtime": "/usr/local/bin/node",
  "eslint.nodePath": "leyman/main/node_modules",
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.useESLintClass": true,
  "eslint.format.enable": false,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  "files.associations": {
    "*.cts": "typescript",
    "*.mts": "typescript"
  },
  // Builds rewrite these, so watching them only adds work
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/dist-test/**": true,
    "**/.coverage/**": true,
    "**/.nx/**": true,
    "**/target/**": true
  },

  "git.ignoreLimitWarning": true,

  "js/ts.preferences.quoteStyle": "single",

  "js/ts.preferences.importModuleSpecifierEnding": "js",
  // TypeScript 7 language server (TypeScriptTeam.native-preview), from the workspace install
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "leyman/main/node_modules/@typescript/native",

  // The lints the `rust-clippy` target enforces
  "rust-analyzer.check.command": "clippy",

  "terminal.integrated.keyboard.protocol": "xterm",

  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 4,
    "files.insertFinalNewline": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 4,
    "files.insertFinalNewline": true
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 2,
    "files.insertFinalNewline": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 2,
    "files.insertFinalNewline": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 4,
    "files.insertFinalNewline": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 4,
    "files.insertFinalNewline": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "files.insertFinalNewline": true
  },

  "gopls": {
    "ui.semanticTokens": true
  }
}
