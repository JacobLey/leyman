    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
