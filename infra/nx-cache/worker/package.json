{
  "name": "@leyman/nx-cache-worker",
  "version": "0.0.1",
  "description": "The hosted Nx remote cache, a Cloudflare Worker on R2 that anyone can read from and only CI on main can write to.",
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
