{
  "name": "nx-lifecycle",
  "version": "1.2.0",
  "description": "Nx plugin that derives every dependsOn from declared lifecycle stages (build, test, …) and the targets bound to them.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/nx-lifecycle"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/nx-lifecycle/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "monorepo",
    "lifecycle",
    "dependsOn",
    "task-pipeline",
    "targets",
    "build",
    "test",
    "cli"
  ],
  "sideEffects": false,
  "executors": "./executors.json",
  "exports": {
    "./plugin": "./dist/plugin/index.js",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/file-content.*",
    "bin.mjs",
    "executors.json",
    "out",
    "!out/.generated.json",
    "WHY-NX-LIFECYCLE.md"
  ],
  "imports": {
    "#schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "#internal/*": "./dist/*"
  },
  "bin": {
    "lifecycle": "./bin.mjs",
    "nx-lifecycle": "./bin.mjs"
  },
  "dependencies": {
    "@nx/devkit": "catalog:",
    "ci-info": "catalog:",
    "entry-script": "workspace:^",
    "fast-equals": "catalog:",
    "format-file": "workspace:^",
    "haywire": "workspace:^",
    "haywire-launcher": "workspace:^",
    "juniper": "workspace:^",
    "juniper-validator": "workspace:^",
    "nx": "catalog:",
    "parse-cwd": "workspace:^",
    "unknown-error": "workspace:^",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "barrelify": "workspace:^",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "load-populate-files": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "sinon": "catalog:",
    "typescript": "catalog:"
  }
}
