{
  "name": "barrelify",
  "version": "2.0.0",
  "description": "Auto-generate TS barrel files.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/apps/barrelify#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "barrel",
    "index",
    "cli"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "barrel": "./bin.mjs",
    "barrelify": "./bin.mjs"
  },
  "dependencies": {
    "ci-info": "catalog:",
    "entry-script": "workspace:^",
    "globby": "catalog:",
    "parse-cwd": "workspace:^",
    "populate-files": "workspace:^",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "ts-dedent": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
