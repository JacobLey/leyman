{
  "name": "barrelify",
  "version": "2.1.2",
  "description": "Generate and CI-verify TypeScript barrel (index.ts) files with the correct ESM/CJS import extensions.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/barrelify"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/apps/barrelify#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "barrel",
    "barrel-file",
    "barrel-files",
    "index.ts",
    "re-export",
    "exports",
    "typescript",
    "esm",
    "commonjs",
    "codegen",
    "cli"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "bin.mjs"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "barrel": "./bin.mjs",
    "barrelify": "./bin.mjs"
  },
  "dependencies": {
    "ci-info": "catalog:",
    "entry-script": "workspace:^",
    "haywire": "workspace:^",
    "haywire-launcher": "workspace:^",
    "ignore": "catalog:",
    "parse-cwd": "workspace:^",
    "populate-files": "workspace:^",
    "tinyglobby": "catalog:",
    "unknown-error": "workspace:^",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "ts-dedent": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
