{
  "name": "drop-when",
  "version": "0.0.1",
  "description": "Marks each workaround with the upstream fix or date that ends it, and reports which ones can be dropped.",
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "bin.mjs"
  ],
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  },
  "bin": {
    "drop-when": "./bin.mjs"
  },
  "dependencies": {
    "entry-script": "workspace:^",
    "haywire": "workspace:^",
    "haywire-launcher": "workspace:^",
    "ignore": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "typescript": "catalog:"
  }
}
