{
  "name": "juniper-validator",
  "version": "0.0.1",
  "description": "StandardSchema compliance for juniper.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/apps/juniper-validator#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "json",
    "StandardSchema"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "ajv": "catalog:",
    "escape-string-regexp": "catalog:"
