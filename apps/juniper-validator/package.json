  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "c8": "catalog:",
    "chai": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "juniper": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "pnpm-dedicated-lockfile": "workspace:^",
    "sinon": "catalog:",
    "typescript": "catalog:"
  }
}
