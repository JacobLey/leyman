{
  "name": "juniper-validator",
  "version": "0.5.1",
  "description": "StandardSchema compliance for juniper.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/juniper-validator"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/juniper-validator/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "json",
    "StandardSchema"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "default-import": "workspace:^"
  },
  "peerDependencies": {
    "juniper": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "juniper": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  }
}
