{
  "name": "xenever",
  "version": "0.0.1",
  "description": "Parse XML into typed objects, validated against a schema written in TypeScript or generated from an XSD.",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/xenever"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/xenever/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "xml",
    "xsd",
    "xml-schema",
    "parser",
    "typescript",
    "types",
    "codegen",
    "validation",
    "standard-schema"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "bin.mjs"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./xsd": "./dist/xsd.js"
  },
  "bin": {
    "xenever": "./bin.mjs"
  },
  "dependencies": {
    "@rgrove/parse-xml": "catalog:",
    "ci-info": "catalog:",
    "entry-script": "workspace:^",
    "format-file": "workspace:^",
    "generated-signature": "workspace:^",
    "parse-cwd": "workspace:^",
    "populate-files": "workspace:^",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@standard-schema/spec": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-24",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  }
}
