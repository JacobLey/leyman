<?xml version="1.0" encoding="UTF-8"?>
<!-- Recursion through a named type and through a global element with an anonymous type. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="tree" type="Node"/>
  <xs:complexType name="Node">
    <xs:sequence>
      <xs:element name="node" type="Node" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:element name="outline">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:string"/>
        <xs:element ref="outline" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
