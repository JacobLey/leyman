{
  "name": "populate-files",
  "version": "1.2.3",
  "description": "Populate static files with dynamic content, and make sure they stay in sync.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/populate-files/ts"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/populate-files/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "content",
    "write",
    "build"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "dependencies": {
    "ci-info": "catalog:",
    "format-file": "workspace:^",
    "generated-signature": "workspace:^",
    "parse-cwd": "workspace:^",
    "uint8array-extras": "catalog:",
    "unknown-error": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@leyman/populate-files-test-vectors": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-24",
    "@types/tmp": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "format-file": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
