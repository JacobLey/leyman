{
  "name": "genever",
  "version": "0.10.5",
  "description": "Generate TypeScript types from JSON Schema files and OpenAPI documents, with strict schema checks and the same types Juniper infers.",
  "engines": {
    "node": ">=24.22.1"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/genever/ts"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/genever/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "json-schema-bundler",
    "json-ref",
    "json-schema",
    "typescript",
    "codegen",
    "types",
    "type-generation",
    "json-schema-to-typescript",
    "juniper",
    "openapi",
    "cli"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "bin.mjs",
    "WHY-GENEVER.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "genever": "./bin.mjs"
  },
  "dependencies": {
    "ci-info": "catalog:",
    "entry-script": "workspace:^",
    "format-file": "workspace:^",
    "generated-signature": "workspace:^",
    "parse-cwd": "workspace:^",
    "populate-files": "workspace:^",
    "yaml": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@leyman/genever-test-vectors": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-24",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "fast-check": "catalog:",
    "juniper": "workspace:^",
    "juniper-arbitrary": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  }
}
