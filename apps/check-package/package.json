{
  "name": "@leyman/check-package",
  "version": "0.1.0",
  "description": "Check an npm package as it would be published, running publint, Are The Types Wrong, a strict typecheck of its declarations, and checks of its Node.js support floor and published files.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/check-package"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/apps/check-package#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "publint",
    "arethetypeswrong",
    "attw",
    "npm",
    "package",
    "publish",
    "lint",
    "types",
    "declarations",
    "engines",
    "ci",
    "cli"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "bin.mjs"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "check-package": "./bin.mjs"
  },
  "dependencies": {
    "@arethetypeswrong/core": "catalog:",
    "entry-script": "workspace:^",
    "ignore": "catalog:",
    "parse-cwd": "workspace:^",
    "publint": "catalog:",
    "semver": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@types/semver": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "tmp-promise": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
