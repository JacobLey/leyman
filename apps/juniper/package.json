{
  "name": "juniper",
  "version": "2.8.1",
  "description": "A JSON Schema builder for TypeScript that infers each schema's type and catches schema mistakes at compile time, with JSON Schema 2020-12 and OpenAPI 3.0 output.",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "apps/juniper"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/juniper/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "json-schema",
    "json-schema-builder",
    "schema",
    "typescript",
    "type-inference",
    "static-types",
    "ajv",
    "openapi",
    "openapi-3",
    "swagger",
    "validation",
    "builder",
    "eslint",
    "eslintplugin"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "WHY-JUNIPER.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./eslint": "./dist/eslint/plugin.js"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "escape-string-regexp": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@typescript/native": "catalog:",
    "ajv": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  }
}
