{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Leyman",
  "dockerComposeFile": "docker-compose.yml",
  "service": "leyman",
  "initializeCommand": "sh .devcontainer/initialize.sh",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "leyman",

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/leyman/main/node_modules/.bin:${containerWorkspaceFolder}/scripts/commands"
  },

  "postCreateCommand": "pnpm install --frozen-lockfile --config.confirmModulesPurge=false",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "ritwickdey.LiveServer",
        "TypeScriptTeam.native-preview"
      ]
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  }
}
