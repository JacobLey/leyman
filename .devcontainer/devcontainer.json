{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Leyman",
  "dockerComposeFile": "docker-compose.yml",
  "service": "leyman",
  "initializeCommand": "sh .devcontainer/initialize.sh",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "leyman",

  "remoteEnv": {
    "NX_PARALLEL": "5",
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/leyman/main/node_modules/.bin:${containerWorkspaceFolder}/scripts/commands"
  },

  "postCreateCommand": {
    "pnpm": "pnpm install --frozen-lockfile --config.confirmModulesPurge=false",
    "dagger": "scripts/commands/dagger-develop || echo 'warning: Dagger bindings not generated, so editors flag dagger/main.go (only editors: dagger generates its own). Run dagger-develop once Docker is up.' >&2",
    "tag-images": "sh .devcontainer/tag-pinned-images.sh"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "github.vscode-github-actions",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "nrwl.angular-console",
        "opentofu.vscode-opentofu",
        "redhat.vscode-yaml",
        "ritwickdey.LiveServer",
        "rust-lang.rust-analyzer",
        "ryanluker.vscode-coverage-gutters",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck",
        "TypeScriptTeam.native-preview",
        "usernamehw.errorlens",
        "yoavbls.pretty-ts-errors"
      ]
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  }
}
