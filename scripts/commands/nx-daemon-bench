#!/usr/bin/env bash
# Measures what the Nx daemon costs and saves in this container: a few `nx` commands timed by hyperfine with and
# without a warm daemon, then the daemon's memory. Ends with a Markdown report.
#
#   nx-daemon-bench <project> [runs] [warmup]     (defaults: 10 runs after 3 warmups, per side and round)
#
# The commands:
# - `nx show projects`: only the project graph, which the daemon keeps in memory.
# - the same after a project changed: before each run a probe project is added or removed, so the graph is rebuilt.
# - `<project>:build` with `--skip-nx-cache`, so it times the tasks rather than cache hits.
# - `<project>:build` again with the cache, every task a hit: once with its outputs on disk (the daemon leaves outputs
#   that already match alone), once with the project's own git-ignored outputs deleted before each run, so they are
#   restored from the cache.
# - `nx run-many -t verify` on a warm cache, with 3 runs after 1 warmup per side and round, since one takes ~40s.
#
# Worktree containers share the host's cores, so load drifts during a run: each command is timed in two rounds, in the
# order no daemon, daemon, daemon, no daemon, and each side's runs are pooled, so a steady drift lands on both sides
# equally.
#
# Memory is the resident set (RSS) of the daemon process, then of the daemon with its child processes (Nx runs plugins
# in workers spawned by the daemon), read 3 times a minute apart after the timed runs and once more after an uncached
# `nx run-many -t build`, followed by `docker stats` for every container of this worktree's compose project. Leaves the
# daemon running, as the devcontainer has it.

set -euo pipefail

probe="$(git rev-parse --show-toplevel)/nx-daemon-bench-probe"

# Run by hyperfine before each run of the changed-graph case.
if [ "${1:-}" = --toggle-probe ]; then
    if [ -e "$probe" ]; then
        rm -r "$probe"
    else
        mkdir "$probe"
        echo '{ "name": "nx-daemon-bench-probe" }' >"$probe/project.json"
    fi
    exit
fi
# Run by hyperfine before each run of the restored-build case, with the outputs to delete.
if [ "${1:-}" = --delete-outputs ]; then
    shift
    rm -rf "$@"
    exit
fi

project="${1:?usage: nx-daemon-bench <project> [runs] [warmup]}"
runs="${2:-10}"
warmup="${3:-3}"
self="$(realpath "$0")"
out="$(mktemp -d)"
trap 'rm -rf "$probe"' EXIT

daemon_pid() {
    nx daemon | sed -n 's/.*Process ID: //p'
}

# RSS in MB of the daemon alone, then summed with every process below it.
memory() {
    local pid tree rss total
    pid="$(daemon_pid)"
    tree="$(ps -e -o pid=,ppid= | awk -v root="$pid" '
        { parent[$1] = $2 }
        END { for (p in parent) { q = p; while (q && q != root) q = parent[q]; if (q == root) print p } }')"
    rss="$(ps -o rss= -p "$pid")"
    # shellcheck disable=SC2086 # one PID per word
    total="$(ps -o rss= -p "$(echo $tree | tr ' ' ,)" | awk '{ s += $1 } END { print s }')"
    echo "$((rss / 1024)) MB, $((total / 1024)) MB with children" >>"$out/memory.txt"
    printf '%s  daemon %4d MB  with children %4d MB (%d processes)\n' \
        "$(date -u +%H:%M:%S)" $((rss / 1024)) $((total / 1024)) "$(echo "$tree" | wc -l)"
}

# The project's own build outputs that git ignores (so never a tracked file such as a generated tsconfig.json), from
# the cacheable tasks in its build's task graph, one per line.
build_outputs() {
    NX_DAEMON=false nx run "${project}:build" --graph=stdout | node --input-type=module -e '
        import { execFileSync } from "node:child_process";
        import { existsSync } from "node:fs";
        const [project] = process.argv.slice(1);
        let json = "";
        for await (const chunk of process.stdin) json += chunk;
        const { graph, tasks } = JSON.parse(json);
        const { root, targets } = graph.nodes[project].data;
        const outputs = Object.values(tasks.tasks)
            .filter(({ target }) => target.project === project && targets[target.target].cache !== false)
            .flatMap(task => task.outputs)
            .filter(path => path.startsWith(`${root}/`) && existsSync(path));
        for (const path of new Set(outputs)) {
            try {
                execFileSync("git", ["check-ignore", "--quiet", path]);
                console.log(path);
            } catch {}
        }
    ' "$project"
}

# One hyperfine set: `measure <case> <side> <round> <runs> <warmup> <command> [prepare]`, side no-daemon or daemon.
measure() {
    local name="$1" side="$2" round="$3" set_runs="$4" set_warmup="$5" command="$6" prepare="${7:-}"
    local args=(--style basic --warmup "$set_warmup" --runs "$set_runs" --export-json "$out/$name.$side.$round.json")
    if [ -n "$prepare" ]; then args+=(--prepare "$prepare"); fi
    if [ "$side" = daemon ]; then nx daemon --start >/dev/null; else nx daemon --stop >/dev/null; fi
    hyperfine "${args[@]}" --env "NX_DAEMON=$([ "$side" = daemon ] && echo true || echo false)" \
        --command-name "$name, $side, round $round" "$command"
}

# Every case in both rounds: `bench <case> <label> <runs> <warmup> <command> [prepare]`.
bench() {
    local name="$1" label="$2"
    shift 2
    printf '%s\t%s\n' "$name" "$label" >>"$out/cases.tsv"
    measure "$name" no-daemon 1 "$@"
    measure "$name" daemon 1 "$@"
    measure "$name" daemon 2 "$@"
    measure "$name" no-daemon 2 "$@"
}

nx_version="$(nx --version | sed -n 's/.*Local: v//p')"
machine="$(nproc) cores, $(free -m | awk '/^Mem:/ { printf "%.0f", $2 / 1024 }') GB RAM visible to the container"
load_start="$(cut -d' ' -f1-3 /proc/loadavg)"
echo "Nx ${nx_version}, hyperfine $(hyperfine --version | cut -d' ' -f2), ${machine}, project ${project}"

bench graph '`nx show projects`' "$runs" "$warmup" 'nx show projects'
bench graph-changed '`nx show projects`, a project changed before each run' "$runs" "$warmup" \
    'nx show projects' "$self --toggle-probe"
rm -rf "$probe"
bench build-uncached "\`nx run ${project}:build --skip-nx-cache\`" "$runs" "$warmup" \
    "nx run ${project}:build --skip-nx-cache"
bench build-cached "\`nx run ${project}:build\`, every task a cache hit, outputs on disk" "$runs" "$warmup" \
    "nx run ${project}:build"
outputs="$(build_outputs | tr '\n' ' ')"
bench build-restored "\`nx run ${project}:build\`, every task a cache hit, outputs deleted (${outputs% })" \
    "$runs" "$warmup" "nx run ${project}:build" "$self --delete-outputs ${outputs% }"
bench verify '`nx run-many -t verify`, warm cache' 3 1 'nx run-many -t verify'
load_end="$(cut -d' ' -f1-3 /proc/loadavg)"

nx daemon --start >/dev/null
echo
echo "Daemon memory, PID $(daemon_pid):"
for reading in 1 2 3; do
    memory
    if [ "$reading" -lt 3 ]; then sleep 60; fi
done
NX_DAEMON=true nx run-many -t build --skip-nx-cache >/dev/null
echo "after nx run-many -t build --skip-nx-cache:"
memory

# Every container of this worktree's compose project, found by the label on this one, with the daemon still warm.
compose_project="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$(hostname)")"
# shellcheck disable=SC2046 # one container ID per word
docker stats --no-stream --format '{{.Name}}\t{{.MemUsage}}' \
    $(docker ps --quiet --filter "label=com.docker.compose.project=${compose_project}") |
    awk -F'\t' '
        { split($2, usage, " / "); mib = usage[1] + 0 }
        usage[1] ~ /GiB/ { mib *= 1024 }
        usage[1] ~ /KiB/ { mib /= 1024 }
        { printf "| %s | %.0f MiB |\n", $1, mib; total += mib }
        END { printf "| **total** | **%.0f MiB** |\n", total }' >"$out/docker.md"

echo
echo "hyperfine JSON in $out"
echo
cat <<EOF
## Nx daemon off vs on

Nx ${nx_version}, ${machine}, $(date -u +%Y-%m-%d). Load average ${load_start} at the start, ${load_end} at the end.
Each command ran in two rounds (off, on, on, off), pooled per side. Reproduce with \`nx-daemon-bench ${project}\`.

| Command | Runs per side | Daemon off: median (range) | Daemon on: median (range) | On vs off |
| --- | --- | --- | --- | --- |
EOF
node --input-type=module - "$out" <<'EOF'
import { readdirSync, readFileSync } from 'node:fs';
const [dir] = process.argv.slice(2);
const times = (name, side) =>
    readdirSync(dir)
        .filter(file => file.startsWith(`${name}.${side}.`))
        .flatMap(file =>
            JSON.parse(readFileSync(`${dir}/${file}`, 'utf8')).results[0].measurements.map(
                ({ time_wall_clock }) => time_wall_clock.value
            )
        )
        .sort((a, b) => a - b);
const median = sorted => {
    const mid = sorted.length / 2;
    return sorted.length % 2 ? sorted[Math.floor(mid)] : (sorted[mid - 1] + sorted[mid]) / 2;
};
const cell = sorted => `${median(sorted).toFixed(2)} s (${sorted[0].toFixed(2)}–${sorted.at(-1).toFixed(2)})`;
for (const line of readFileSync(`${dir}/cases.tsv`, 'utf8').trim().split('\n')) {
    const [name, label] = line.split('\t');
    const off = times(name, 'no-daemon');
    const on = times(name, 'daemon');
    const change = (median(on) - median(off)) * 1000;
    console.log(
        `| ${label} | ${off.length} | ${cell(off)} | ${cell(on)} | ${change > 0 ? '+' : ''}${change.toFixed(0)} ms |`
    );
}
EOF
readarray -t readings <"$out/memory.txt"
cat <<EOF

| Daemon memory (RSS) | |
| --- | --- |
| idle, 3 readings a minute apart | ${readings[0]}; ${readings[1]}; ${readings[2]} |
| after \`nx run-many -t build --skip-nx-cache\` | ${readings[3]} |

| Compose project \`${compose_project}\`, daemon on (\`docker stats\`) | Memory |
| --- | --- |
$(cat "$out/docker.md")
EOF
