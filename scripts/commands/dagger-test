#!/usr/bin/env bash

set -e

# CI's `test` and `floors` jobs, one after the other. Extra arguments (e.g. `--floor-suites`) go to `test`

# `--uncached` runs every task, for a suspected missing Nx input or a last check before a release
if [ "${1:-}" = "--uncached" ]; then
    shift
    dagger call --mod ./dagger test "$@"
    exec dagger call --mod ./dagger floors
fi

if ! getent hosts dagger-nx-cache > /dev/null; then
    echo 'error: no dagger-nx-cache service: rebuild the devcontainer, or run dagger-test --uncached' >&2
    exit 1
fi

# Reached from this container by the Dagger CLI, and bound to `nx-cache:3000` inside Dagger
dagger call --mod ./dagger test --nx-cache=tcp://dagger-nx-cache:3000 "$@"
exec dagger call --mod ./dagger floors --nx-cache=tcp://dagger-nx-cache:3000
