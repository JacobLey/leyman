{
  "name": "pg-dolly",
  "version": "0.3.2",
  "description": "A fresh Postgres database for every test, cloned from a template built once from your schema's SQL.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/pg-dolly"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/pg-dolly/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "testing",
    "integration-test",
    "test-database",
    "template",
    "fixtures"
  ],
  "sideEffects": false,
  "types": "./dist/pg-dolly.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "WHY-PG-DOLLY.md"
  ],
  "exports": {
    ".": "./dist/pg-dolly.js"
  },
  "dependencies": {
    "pg": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  }
}
