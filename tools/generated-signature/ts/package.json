{
  "name": "generated-signature",
  "version": "0.3.2",
  "description": "Sign generated files so hand edits are detected, while keeping manual sections editable.",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/generated-signature/ts"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/generated-signature/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "codegen",
    "generated",
    "signature",
    "checksum",
    "eslint",
    "eslintplugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/generated-signature.js",
    "./eslint": "./dist/eslint/plugin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@leyman/generated-signature-test-vectors": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
