{
  "name": "common-proxy",
  "version": "1.0.1",
  "description": "Wrap an ESM import so it is synchronously available as a promise-returning function in CommonJS.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/common-proxy"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/common-proxy#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "commonjs",
    "esm",
    "interop",
    "dynamic-import",
    "async",
    "proxy",
    "import"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.cjs"
  },
  "dependencies": {
    "@swc/helpers": "catalog:",
    "default-import": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "barrelify": "workspace:^",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  }
}
