{
  "name": "lease-cache",
  "version": "0.4.2",
  "description": "A read-through cache for Valkey or Redis that shares one load per key across all your servers, and handles invalidating a key while it loads.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/lease-cache"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/lease-cache/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "cache",
    "read-through",
    "lease",
    "stampede",
    "thundering-herd",
    "valkey",
    "redis"
  ],
  "sideEffects": false,
  "types": "./dist/lease-cache.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "WHY-LEASE-CACHE.md"
  ],
  "exports": {
    ".": "./dist/lease-cache.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@typescript/native": "catalog:",
    "@valkey/valkey-glide": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "ioredis": "catalog:",
    "iovalkey": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "p-defer": "catalog:",
    "redis": "catalog:",
    "typescript": "catalog:"
  }
}
