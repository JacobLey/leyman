{
  "name": "lease-cache",
  "version": "0.3.0",
  "description": "Read-through caching on Valkey or Redis with leases: one load per key across every instance, and a load that finishes after an invalidation never caches its outdated value.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/lease-cache"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/lease-cache#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "cache",
    "read-through",
    "lease",
    "stampede",
    "thundering-herd",
    "valkey",
    "redis"
  ],
  "sideEffects": false,
  "types": "./dist/lease-cache.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "WHY-LEASE-CACHE.md"
  ],
  "exports": {
    ".": "./dist/lease-cache.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@valkey/valkey-glide": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "ioredis": "catalog:",
    "iovalkey": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "p-defer": "catalog:",
    "redis": "catalog:",
    "typescript": "catalog:"
  }
}
