    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "consistent-hashing",
    "consistent-hash",
    "jump-hash",
    "hash",
    "sharding",
    "load-balancing",
    "partitioning",
    "constant-time",
    "stateless",
    "minimal-disruption"
