{
  "name": "oauth-dev-server",
  "version": "0.0.1",
  "description": "A local OAuth 2.1 authorization server for tests: oidc-provider with a dev login, issuing audience-bound JWT access tokens through the real flow.",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/oauth-dev-server"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/oauth-dev-server#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "oauth",
    "oauth2",
    "oidc",
    "authorization-server",
    "testing",
    "integration-test",
    "pkce",
    "token-exchange",
    "mcp"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "types": "./dist/oauth-dev-server.js",
  "exports": {
    ".": "./dist/oauth-dev-server.js",
    "./mcp": "./dist/mcp.js"
  },
  "dependencies": {
    "jose": "catalog:",
    "oidc-provider": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "catalog:"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@modelcontextprotocol/client": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/oidc-provider": "catalog:",
    "@types/sinon": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "sinon": "catalog:",
    "typescript": "catalog:"
  }
}
