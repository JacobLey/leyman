  "scenarios": [
    {
      "description": "a key runs once, then replays its response",
      "requests": {
        "a": {
          "scope": "user_1",
          "operation": "createNote",
          "key": "k1",
          "method": "POST",
          "target": "/notes",
          "headers": [],
          "body": "{\"title\":\"Hi\"}"
        }
      },
      "steps": [
        {
          "begin": "first",
          "request": "a",
          "expect": "run"
        },
        {
          "respond": "first",
          "response": {
            "status": 201,
            "headers": [
              [
                "content-type",
                "application/json"
              ],
              [
                "set-cookie",
                "a=1"
              ],
              [
                "set-cookie",
                "b=2"
              ]
            ],
            "body": "{\"id\":\"n_1\"}"
          },
          "expect": "stored"
        },
        {
          "begin": "retry",
          "request": "a",
          "expect": "replay",
          "response": {
            "status": 201,
            "headers": [
              [
                "content-type",
                "application/json"
              ],
              [
                "set-cookie",
                "a=1"
              ],
              [
                "set-cookie",
                "b=2"
              ]
            ],
            "body": "{\"id\":\"n_1\"}"
          }
        },
        {
          "begin": "again",
          "request": "a",
          "expect": "replay",
          "response": {
            "status": 201,
            "headers": [
              [
                "content-type",
                "application/json"
              ],
              [
                "set-cookie",
                "a=1"
              ],
