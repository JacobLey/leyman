{
  "name": "haywire",
  "version": "1.0.0",
  "description": "Compile-time checked dependency injection for TypeScript — no decorators, no reflect-metadata, no global state.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/haywire"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/haywire#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "inversion-of-control",
    "container",
    "typescript",
    "type-safe",
    "compile-time",
    "no-decorators",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "imports": {
    "#binding": "./dist/lib/binding.js",
    "#container": "./dist/lib/container.js",
    "#errors": "./dist/lib/errors.js",
    "#container-factory": "./dist/lib/container-factory.js",
    "#identifier": "./dist/lib/identifier.js",
    "#module": "./dist/lib/module.js",
    "#scopes": "./dist/lib/scopes.js",
    "#types": "./dist/lib/types.js",
    "#internal/*": "./dist/*"
  },
  "dependencies": {
    "p-defer": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "npm-barrelify": "catalog:leyman",
    "typescript": "catalog:"
  }
}
