{
  "name": "haywire",
  "version": "0.1.8",
  "description": "Type safe dependency injection",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/haywire#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "typescript",
    "dependency injection",
    "inversion of control",
    "type-safe"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "imports": {
    "#binding": "./dist/lib/binding.js",
    "#container": "./dist/lib/container.js",
    "#errors": "./dist/lib/errors.js",
    "#container-factory": "./dist/lib/container-factory.js",
    "#identifier": "./dist/lib/identifier.js",
    "#module": "./dist/lib/module.js",
    "#scopes": "./dist/lib/scopes.js",
    "#types": "./dist/lib/types.js",
    "#internal/*": "./dist/*"
  },
  "dependencies": {
    "p-defer": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "barrelify": "workspace:^",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "typescript": "catalog:"
  }
}
