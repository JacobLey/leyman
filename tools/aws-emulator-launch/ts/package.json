{
  "name": "aws-emulator-launch",
  "version": "0.0.1",
  "description": "Starts AWS Emulator for tests, on a free port, and returns its endpoint, credentials and certificate authority.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/aws-emulator-launch/ts"
  },
  "homepage": "https://jacobley.github.io/leyman/packages/aws-emulator-launch/",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "sideEffects": false,
  "types": "./dist/aws-emulator-launch.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "exports": {
    ".": "./dist/aws-emulator-launch.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:node-22",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  },
  "keywords": [
    "aws",
    "aws-emulator",
    "emulator",
    "dynamodb",
    "sqs",
    "testing",
    "test",
    "local"
  ],
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  }
}
