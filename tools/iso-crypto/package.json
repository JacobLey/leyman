{
  "name": "iso-crypto",
  "version": "2.1.0",
  "description": "Isomorphic cryptography for browsers and Node.js — one API over WebCrypto and node:crypto for hashing, AES (including GCM), PBKDF2/HKDF key derivation and ECDH.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobLey/leyman.git",
    "directory": "tools/iso-crypto"
  },
  "homepage": "https://github.com/JacobLey/leyman/tree/main/tools/iso-crypto#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "keywords": [
    "cryptography",
    "crypto",
    "isomorphic",
    "browser",
    "webcrypto",
    "subtlecrypto",
    "encryption",
    "aes",
    "aes-gcm",
    "pbkdf2",
    "hkdf",
    "ecdh",
    "ecc",
    "sha",
    "hash",
    "encode"
  ],
  "sideEffects": false,
  "types": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "imports": {
    "#ecc": {
      "types": "./dist/iso/ecc/types.js",
      "browser": "./dist/iso/ecc/browser.js",
      "default": "./dist/iso/ecc/node.js"
    },
    "#encode": "./dist/iso/encode.js",
    "#derive": {
      "types": "./dist/iso/derive/types.js",
      "browser": "./dist/iso/derive/browser.js",
      "default": "./dist/iso/derive/node.js"
    },
    "#encrypt": {
      "types": "./dist/iso/encrypt/types.js",
      "browser": "./dist/iso/encrypt/browser.js",
      "default": "./dist/iso/encrypt/node.js"
    },
    "#hash": {
      "types": "./dist/iso/hash/types.js",
      "browser": "./dist/iso/hash/browser.js",
      "default": "./dist/iso/hash/node.js"
    },
    "#random": {
      "types": "./dist/iso/random/types.js",
      "browser": "./dist/iso/random/browser.js",
      "default": "./dist/iso/random/node.js"
    },
    "#internal/*": "./dist/*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@typescript/native": "catalog:",
    "barrelify": "workspace:^",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "sinon": "catalog:",
    "typescript": "catalog:"
  }
}
