{
  "extends": "../../../configs/tsconfig.build.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "allowArbitraryExtensions": true
  },
  "contentMappers": [
    {
      "package": "genever-content-mapper",
      "extensions": [
        ".openapi.yaml"
      ],
      "options": {
        "parameterDefaults": true
      }
    }
  ],
  "include": [
    "src",
    "*.d.ts"
  ],
  "references": [
    {
      "path": "../../../tools/haywire"
    },
    {
      "path": "../../../tools/default-import"
    },
    {
      "path": "../spec"
    },
    {
      "path": "../database"
    },
    {
      "path": "../../../apps/trusted-tsc"
    },
    {
      "path": "../../../tools/pg-dolly"
    },
    {
      "path": "../../../tools/oauth-dev-server"
    },
    {
      "path": "../../../tools/test-chain/mocha-chain"
    },
    {
      "path": "../../../apps/genever-content-mapper"
    },
    {
      "path": "../../../leyman/expect"
    },
    {
      "path": "../../../leyman/eslint-config"
    },
    {
      "path": "../client"
    }
  ]
}
