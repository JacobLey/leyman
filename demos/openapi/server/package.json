{
  "name": "@leyman/demo-openapi-server",
  "version": "0.0.1",
  "description": "The notes API for the OpenAPI demo, a Hono server on Postgres with Drizzle that validates every request and response against openapi.json, and checks bearer tokens (static tokens or JWTs) and their scopes.",
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/demos/openapi/server#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "types": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "imports": {
    "#internal/*": "./dist/*",
    "#test/*": "./dist-test/*"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@leyman/demo-openapi-database": "workspace:^",
    "@leyman/demo-openapi-spec": "workspace:^",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "default-import": "workspace:^",
    "drizzle-orm": "catalog:",
    "haywire": "workspace:^",
    "hono": "catalog:",
    "idempotency-keys": "workspace:^",
    "jose": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/demo-openapi-client": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:typescript-next",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "fast-check": "catalog:",
    "genever-content-mapper": "workspace:^",
    "juniper": "workspace:^",
    "juniper-arbitrary": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "oauth-dev-server": "workspace:^",
    "pg-dolly": "workspace:^",
    "trusted-tsc": "workspace:^",
    "typescript": "catalog:"
  },
  "trustedContentMappers": [
    "genever-content-mapper"
  ]
}
