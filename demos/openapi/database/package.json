{
  "name": "@leyman/demo-openapi-database",
  "version": "0.0.1",
  "description": "The Postgres schema for the OpenAPI demo, with its Drizzle tables, the migrations that build them, and a schema.sql snapshot of the result for tests to clone.",
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/demos/openapi/database#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "migrations",
    "schema.sql"
  ],
  "types": "./dist/database.js",
  "exports": {
    ".": "./dist/database.js",
    "./schema.sql": "./schema.sql"
  },
  "imports": {
    "#internal/*": "./dist/*"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "idempotency-keys": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "pg": "catalog:",
    "pg-dolly": "workspace:^",
    "pg-dolly-schema": "workspace:^",
    "typescript": "catalog:"
  }
}
