{
  "name": "@leyman/demo-openapi-client",
  "version": "0.0.1",
  "description": "A typed client for the OpenAPI demo's notes API, with types imported from the spec through a content mapper and routes read from openapi.json at runtime.",
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "type": "module",
  "author": "JacobLey",
  "license": "MIT",
  "repository": "JacobLey/leyman",
  "homepage": "https://github.com/JacobLey/leyman/tree/main/demos/openapi/client#readme",
  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "types": "./dist/client.js",
  "exports": {
    ".": "./dist/client.js"
  },
  "dependencies": {
    "@leyman/demo-openapi-spec": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:typescript-next",
    "c8": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "genever-content-mapper": "workspace:^",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "trusted-tsc": "workspace:^",
    "typescript": "catalog:"
  },
  "imports": {
    "#internal/*": "./dist/*"
  },
  "trustedContentMappers": [
    "genever-content-mapper"
  ]
}
