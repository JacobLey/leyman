{
  "$schema": "../../../leyman/main/node_modules/nx/schemas/project-schema.json",
  "name": "@leyman/demo-openapi-client",
  "targets": {
    "biome": {},
    "eslint": {},
    "update-ts-references": {},
    "tsc": {
      "options": {
        "commands": [
          "rm -rf ./dist",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths --only '**/*.ts?(x)'",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths --only '**/*.mts?(x)' --out-file-extension mjs",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths -C module.type=commonjs -C module.ignoreDynamic=true -C module.exportInteropAnnotation=true --only '**/*.cts?(x)' --out-file-extension cjs",
          "tsc --runExternalCode"
        ]
      }
    },
    "tsc-test": {
      "options": {
        "commands": [
          "rm -rf ./dist-test",
          "swc ./test -d ./dist-test --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths -C jsc.externalHelpers=false --only '**/*.ts?(x)'",
          "swc ./test -d ./dist-test --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths -C jsc.externalHelpers=false --only '**/*.mts?(x)' --out-file-extension mjs",
          "swc ./test -d ./dist-test --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths -C jsc.externalHelpers=false -C module.type=commonjs -C module.ignoreDynamic=true -C module.exportInteropAnnotation=true --only '**/*.cts?(x)' --out-file-extension cjs",
          "tsc -p ./test --runExternalCode"
        ]
      }
    },
    "mocha-unit-test": {},
    "coverage-report": {},
    "sync-injected": {},
    "install:_": {},
    "install": {},
    "prepare:_": {},
    "prepare:generate": {},
    "prepare:format": {},
    "prepare": {},
    "check:_": {},
    "check:lint": {},
    "check": {},
    "build:_": {},
    "build:run": {},
    "build:post": {},
    "build:sync": {},
    "build": {},
    "test:_": {},
    "test:compile": {},
    "test:run": {},
    "test:report": {},
    "test": {},
    "verify:_": {},
    "verify": {}
  }
}
