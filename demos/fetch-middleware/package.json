  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "sideEffects": false,
  "types": "./dist/fetch-middleware.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "exports": {
    ".": "./dist/fetch-middleware.js"
  },
  "dependencies": {
    "ky": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "typescript": "catalog:"
  }
}
