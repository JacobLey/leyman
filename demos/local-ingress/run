#!/bin/sh
# Runs the demo's dev server in a container behind tools/local-ingress, so the host needs only Docker: no Node,
# pnpm or Nx. It serves at `https://demo.<worktree>.<repo>.localhost`, beside the devcontainer's own
# `https://<worktree>.<repo>.localhost`, and edits to the checkout reload the page. Stop it with Ctrl-C.
set -eu

demo="$(cd "$(dirname "$0")" && pwd -P)"
cd "$demo"
checkout="$(git rev-parse --show-toplevel)"
. "$checkout/.devcontainer/names.sh"

# The Node the devcontainer and CI run (`nodeImage` in dagger/main.go)
image='node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea'
# The lockfile's version of the catalog's `vite`, the demo's only runtime dependency
vite="$(awk '/^catalogs:/ { catalogs = 1 } catalogs && /^    vite:/ { getline; getline; print $2; exit }' \
    "$checkout/pnpm-lock.yaml")"

sh "$checkout/tools/local-ingress/ensure"

host="demo.$worktree_name.$repo_name.localhost"
port=''
case "${LOCAL_INGRESS_HTTPS_PORT:-443}" in
443) ;;
*) port=":$LOCAL_INGRESS_HTTPS_PORT" ;;
esac
echo "Serving at https://$host$port once Vite is ready"

tty=''
if [ -t 0 ]; then
    tty='--interactive --tty'
fi

# The checkout is mounted read-only at its own path, so the demo's tsconfig finds the configs it extends. Vite is
# installed inside the container, holding transitive dependencies to the 7-day rule with `--before`. Node strips
# the config's types itself (`--configLoader native`), so the demo isn't built first.
# shellcheck disable=SC2086,SC2016 # $tty is zero or two flags; the script expands its variables in the container
docker run --rm --init $tty \
    --name "local-ingress-demo-$repo_name-$worktree_name" \
    --network local-ingress \
    --label "caddy=$host" \
    --label 'caddy.reverse_proxy={{upstreams 5173}}' \
    --label caddy.tls=internal \
    --env "WORKTREE_NAME=$worktree_name" \
    --env "REPO_NAME=$repo_name" \
    --env "TUNNEL_HOST=${TUNNEL_HOST:-}" \
    --env "DEMO=$demo" \
    --env "VITE_VERSION=$vite" \
    --volume "$checkout:$checkout:ro" \
    --workdir /tmp \
    "$image" sh -euc '
        npm install --silent --no-save --no-package-lock --no-audit --no-fund \
            --before "$(date -u -d "7 days ago" +%Y-%m-%dT%H:%M:%SZ)" "vite@$VITE_VERSION"
        # `cacheDir` moves Vite'\''s cache out of the read-only checkout
        cat > vite.config.mjs <<EOF
import { createViteConfig } from "$DEMO/src/vite-config.ts";
export default { ...createViteConfig(), root: "$DEMO", cacheDir: "/tmp/vite" };
EOF
        exec node_modules/.bin/vite --configLoader native --config vite.config.mjs
    '
