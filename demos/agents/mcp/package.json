    "@biomejs/biome": "catalog:",
    "@hono/node-server": "catalog:",
    "@leyman/configs": "workspace:^",
    "@leyman/demo-openapi-database": "workspace:^",
    "@leyman/demo-openapi-server": "workspace:^",
    "@leyman/eslint-config": "workspace:^",
    "@leyman/expect": "workspace:^",
    "@modelcontextprotocol/client": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/sinon": "catalog:",
    "@typescript/native": "catalog:",
    "c8": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "expect-type": "catalog:",
    "mocha": "catalog:",
    "mocha-chain": "workspace:^",
    "oauth-dev-server": "workspace:^",
    "pg": "catalog:",
