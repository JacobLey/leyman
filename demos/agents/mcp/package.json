  "bugs": {
    "url": "https://github.com/JacobLey/leyman/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "types": "./dist/mcp.js",
  "exports": {
    ".": "./dist/mcp.js"
  },
  "imports": {
    "#internal/*": "./dist/*"
  },
  "dependencies": {
    "@leyman/demo-openapi-client": "workspace:^",
