{
  "$schema": "./leyman/main/node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "pnpm"
  },
  "generators": {
    "@leyman/nx-plugin": {
      "package": {
        "config": "leyman/main/nx-plugin.json",
        "repository": "https://github.com/JacobLey/leyman",
        "author": "JacobLey",
        "license": "MIT",
        "devDependencies": [
          "@typescript/native"
        ]
      }
    }
  },
  "namedInputs": {
    "shared-globals": [
      {
        "runtime": "node --version"
      }
    ],
    "postgres": [
      {
        "runtime": "pg_dump --version"
      },
      {
        "runtime": "psql \"$DATABASE_URL\" -XtAc 'SHOW server_version'"
      }
    ],
    "valkey": [
      {
        "runtime": "node -e \"const s=require('node:net').connect(6379,'valkey',()=>s.end('INFO server\\r\\n'));let d='';s.on('data',c=>d+=c).on('end',()=>console.log(/valkey_version:(\\S+)/.exec(d)[1]))\""
      }
    ],
    "package-files": [
      "{projectRoot}/package.json",
      "dependency-files"
    ],
    "dependency-files": [
      "{projectRoot}/executors.json",
      "{projectRoot}/*.(c|m)?js",
      "{projectRoot}/*.d.(c|m)?ts",
      "{projectRoot}/data/**/*",
      "{projectRoot}/out/**/*"
    ],
    "eslint-input": [
      "{projectRoot}/eslint.config.js"
    ],
    "ts-source": [
      {
        "runtime": "node --version"
      },
      "{workspaceRoot}/leyman/configs/c8rc.json",
      "{workspaceRoot}/leyman/configs/swcrc.jsonc",
      "{workspaceRoot}/leyman/configs/tsconfig.*.json",
      "{workspaceRoot}/leyman/configs/vitest.config.js",
      "{workspaceRoot}/leyman/nx-plugin/scripts/**/*",
      "{projectRoot}/package.json",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/src/**/*",
      {
        "externalDependencies": []
      }
    ],
    "dependency-builds": [
      {
        "dependentTasksOutputFiles": "**/package-surface.json",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.js",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.mjs",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.cjs",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.d.ts",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.d.mts",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.d.cts",
        "transitive": true
      },
      {
        "dependentTasksOutputFiles": "**/dist/**/*.wasm",
        "transitive": true
      }
    ],
    "test-source": [
      "ts-source",
      "{projectRoot}/test/**/*",
      "package-files",
      "dependency-builds",
      "{projectRoot}/schema.sql"
    ],
    "rustSource": [
      "{projectRoot}/Cargo.toml",
      "{projectRoot}/src/**/*.rs",
      "{projectRoot}/tests/**/*.rs",
      "{projectRoot}/data/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      {
        "externalDependencies": []
      }
    ],
    "goSource": [
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{projectRoot}/**/*.go",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ]
  },
  "sync": {
    "applyChanges": true
  },
  "targetDefaults": {
    "biome": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/biome-format.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "check": {
          "commands": [
            "biome format ."
          ]
        }
      },
      "cache": false,
      "dependsOn": [
        "prepare:generate"
      ]
    },
    "dagger-develop": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/dagger-develop.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "prepare:_"
      ]
    },
    "gofmt": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/gofmt.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "prepare:generate"
      ]
    },
    "rustfmt": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/rustfmt.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "prepare:generate"
      ]
    },
    "tofu-fmt": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/tofu-fmt.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "prepare:generate"
      ]
    },
    "tofu-validate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/tofu-validate.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.tf",
        "{projectRoot}/.terraform.lock.hcl",
        "{workspaceRoot}/scripts/nx/tofu-validate.sh",
        {
          "runtime": "tofu version"
        }
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "eslint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "{projectRoot}/node_modules/.bin/eslint {projectRoot} --color"
        ],
        "color": true
      },
      "configurations": {
        "fix": {
          "fix": true
        }
      },
      "cache": true,
      "inputs": [
        "eslint-input",
        "ts-source",
        "{projectRoot}/test/**/*",
        "package-files",
        "dependency-builds",
        "^dependency-files"
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "check-workspace-dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ${NX_WORKSPACE_ROOT}/leyman/main/scripts/check-workspace-dependencies.mjs"
        ],
        "color": true
      },
      "cache": true,
      "inputs": [
        "shared-globals",
        "{workspaceRoot}/leyman/main/scripts/check-workspace-dependencies.mjs",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/**/package.json"
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "drizzle-kit-check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/drizzle-kit-check.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "shared-globals",
        "{projectRoot}/package.json",
        "{projectRoot}/drizzle.config.*",
        "{projectRoot}/src/**/*",
        "{projectRoot}/migrations/**/*",
        {
          "externalDependencies": []
        }
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "check-package": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "check-package --profile esm-only --floor-tsconfig @leyman/configs/tsconfig.node-{major}.json"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        {
          "runtime": "node --version"
        },
        "{projectRoot}/**/*",
        "!{projectRoot}/CHANGELOG.md",
        "!{projectRoot}/eslint.config.js",
        "!{projectRoot}/test/**/*",
        "{workspaceRoot}/.gitignore",
        "dependency-builds",
        {
          "externalDependencies": [
            "@arethetypeswrong/core",
            "ignore",
            "publint",
            "semver",
            "typescript"
          ]
        }
      ],
      "outputs": [],
      "dependsOn": [
        {
          "projects": [
            "@leyman/check-package"
          ],
          "target": "build"
        },
        "check:_"
      ]
    },
    "check-fork-manifest": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ${NX_WORKSPACE_ROOT}/leyman/main/scripts/check-fork-manifest.mjs"
        ],
        "color": true
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/*",
        "{workspaceRoot}/.agents/**/*",
        "{workspaceRoot}/.claude/**/*",
        "{workspaceRoot}/.devcontainer/**/*",
        "{workspaceRoot}/.github/**/*",
        "{workspaceRoot}/.vscode/**/*",
        "{workspaceRoot}/dagger/**/*",
        "{workspaceRoot}/leyman/**/*",
        "{workspaceRoot}/patches/**/*",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/tools/local-ingress/**/*"
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "check-skills": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "[ ! -e .agents ] || node leyman/main/scripts/link-skills.mjs --check"
        ],
        "color": true,
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "dependsOn": [
        "check:_"
      ]
    },
    "check-parity": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ${NX_WORKSPACE_ROOT}/leyman/main/scripts/check-parity.mjs"
        ],
        "color": true
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/leyman/main/scripts/check-parity.mjs",
        "{workspaceRoot}/.devcontainer/Dockerfile",
        "{workspaceRoot}/.devcontainer/docker-compose.yml",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/adoption-audits.yml",
        "{workspaceRoot}/.github/workflows/comparison-report.yml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/dagger/dagger.json",
        "{workspaceRoot}/dagger/main.go",
        "{workspaceRoot}/demos/local-ingress/run",
        "{workspaceRoot}/infra/nx-cache/tofu/variables.tf",
        "{workspaceRoot}/infra/nx-cache/worker/wrangler.jsonc",
        "{workspaceRoot}/pnpm-workspace.yaml"
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "go-lint": {
      "options": {
        "linter": "golangci-lint",
        "args": [
          "run"
        ]
      },
      "cache": true,
      "inputs": [
        "goSource",
        "^goSource",
        "{workspaceRoot}/.golangci.yml",
        {
          "runtime": "go version"
        },
        {
          "runtime": "golangci-lint version --short"
        }
      ],
      "dependsOn": [
        "check:_"
      ]
    },
    "rust-clippy": {
      "cache": true,
      "inputs": [
        "rustSource",
        "^rustSource",
        "^dependency-files",
        {
          "runtime": "rustc --version"
        }
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "barrelify": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "barrel"
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "prepare:_"
      ],
      "cache": true,
      "inputs": [
        "shared-globals",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "dependency-builds",
        "^dependency-files",
        {
          "externalDependencies": []
        }
      ],
      "outputs": [
        "{projectRoot}/**/index.(c|m)?ts"
      ]
    },
    "schema-snapshot": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pg-dolly-schema"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "prepare:_"
      ],
      "cache": true,
      "inputs": [
        "shared-globals",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{projectRoot}/migrations/**/*",
        "{projectRoot}/schema.sql",
        "dependency-builds",
        "^dependency-files",
        "postgres",
        {
          "env": "CI"
        },
        {
          "externalDependencies": []
        }
      ],
      "outputs": [
        "{projectRoot}/schema.sql"
      ]
    },
    "update-ts-references": {
      "executor": "nx:noop",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": [
        "prepare:_"
      ]
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/clean-dist.sh",
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/swc-compile.sh ./src ./dist node_modules/@leyman/configs/swcrc.jsonc",
          "${TSC:-tsc}"
        ],
        "parallel": false,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "dependency-builds",
        "^dependency-files"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "build:_"
      ]
    },
    "rust-wasm": {
      "cache": true,
      "inputs": [
        "rustSource",
        "^rustSource",
        "^dependency-files",
        {
          "runtime": "rustc --version"
        },
        {
          "runtime": "wasm-bindgen --version"
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "build:_"
      ]
    },
    "vitepress-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf ./dist",
          "vitepress build"
        ],
        "parallel": false,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "shared-globals",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.twoslash.json",
        "{projectRoot}/.vitepress/**/*",
        "{projectRoot}/src/**/*",
        {
          "externalDependencies": []
        },
        "dependency-builds",
        "^package-files"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "build:_"
      ]
    },
    "tsc-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf ./dist-test",
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/swc-compile.sh ./test ./dist-test node_modules/@leyman/configs/swcrc.jsonc",
          "${TSC:-tsc} -p ./test"
        ],
        "parallel": false,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "test-source",
        "^dependency-files"
      ],
      "outputs": [
        "{projectRoot}/dist-test"
      ],
      "dependsOn": [
        "test:_"
      ]
    },
    "populate-files": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "load-populate-files --filePath ./dist/file-content.js --target-dir ./out --manifest ./out/.generated.json --clean"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "dependency-builds",
        "^dependency-files"
      ],
      "outputs": [
        "{projectRoot}/out"
      ],
      "dependsOn": [
        "build:run"
      ]
    },
    "sync-injected": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/sync-injected.mjs"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "outputs": [
        "{workspaceRoot}/.package-surface/{projectName}/package-surface.json"
      ],
      "dependsOn": [
        "build:post"
      ]
    },
    "playwright-install": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "[ -n \"$PW_TEST_CONNECT_WS_ENDPOINT\" ] || playwright install chromium firefox webkit"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "test:_"
      ]
    },
    "mocha-unit-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none mocha --recursive \"$PWD/dist-test/unit/**/*.spec.*js\""
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "test-source",
        "^dependency-files"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/unit"
      ],
      "dependsOn": [
        "test:compile"
      ]
    },
    "mocha-integration-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none mocha --timeout 10000 --recursive \"$PWD/dist-test/integration/**/*.spec.*js\""
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "test-source",
        "^dependency-files"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/integration"
      ],
      "dependsOn": [
        "test:compile"
      ]
    },
    "vitest-unit-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none vitest run --config node_modules/@leyman/configs/vitest.config.js --root ."
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "test-source",
        "^dependency-files"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/unit"
      ],
      "dependsOn": [
        "test:compile"
      ]
    },
    "go-test": {
      "options": {
        "cover": true,
        "coverProfile": "cover.out"
      },
      "cache": true,
      "inputs": [
        "goSource",
        "^goSource",
        "^dependency-files",
        "^rustSource",
        {
          "runtime": "go version"
        }
      ],
      "dependsOn": [
        "test:compile"
      ],
      "outputs": [
        "{projectRoot}/cover.out"
      ]
    },
    "rust-test": {
      "cache": true,
      "inputs": [
        "rustSource",
        "^rustSource",
        "^dependency-files",
        {
          "runtime": "rustc --version"
        }
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "dependsOn": [
        "test:compile"
      ]
    },
    "coverage-report": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/leyman/nx-plugin/scripts/coverage-report.sh node_modules/@leyman/configs/c8rc.json"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        {
          "runtime": "node --version"
        },
        "ts-source",
        {
          "dependentTasksOutputFiles": ".coverage/project/**/*.json",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/report"
      ],
      "dependsOn": [
        "test:run"
      ]
    },
    "go-coverage-report": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/go-coverage-report.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "goSource",
        {
          "runtime": "go version"
        },
        "{workspaceRoot}/scripts/nx/go-coverage-report.sh",
        {
          "dependentTasksOutputFiles": "**/cover.out"
        }
      ],
      "outputs": [],
      "dependsOn": [
        "test:run"
      ]
    },
    "rust-coverage-report": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/rust-coverage-report.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "rustSource",
        "{workspaceRoot}/scripts/nx/rust-coverage-report.sh",
        {
          "runtime": "rustc --version"
        },
        {
          "dependentTasksOutputFiles": "**/coverage/llvm-cov.json"
        }
      ],
      "outputs": [],
      "dependsOn": [
        "test:run"
      ]
    },
    "check-version": {
      "dependsOn": [
        "check:_"
      ]
    },
    "install:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "install": {
      "executor": "nx:noop",
      "dependsOn": [
        "install:_"
      ],
      "configurations": {
        "__lifecycle": {}
      }
