{
  "$schema": "./leyman/main/node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "pnpm"
  },
  "namedInputs": {
    "eslint-input": [
      "{projectRoot}/eslint.config.js"
    ],
    "ts-source": [
      "{workspaceRoot}/configs/c8rc.json",
      "{workspaceRoot}/configs/swcrc.jsonc",
      "{workspaceRoot}/tsconfig.build.json",
      "{projectRoot}/package.json",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/src/**/*.(c|m)?tsx?",
      "{projectRoot}/src/**/*.json",
      "{projectRoot}/src/tests",
      {
        "externalDependencies": []
      }
    ],
    "ts-output": [
      "{projectRoot}/package.json",
      "{projectRoot}/dist/**/*.(c|m)?js",
      "{projectRoot}/dist/**/*.d.(c|m)?ts",
      "{projectRoot}/(dist|src)/**/*.json",
      "!{projectRoot}/(dist|src)/tests"
    ]
  },
  "sync": {
    "applyChanges": true
  },
  "targetDefaults": {
    "biome": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/biome-format.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "check": {
          "commands": [
            "biome format ."
          ]
        }
      },
      "dependsOn": [
        "prepare:generate"
      ],
      "cache": false,
      "inputs": [
        "{projectRoot}/*.json",
        "{projectRoot}/*.(c|m)?js",
        "{projectRoot}/src/**/*.(c|m)?tsx?",
        "{projectRoot}/src/**/*.json"
      ],
      "outputs": [
        "{projectRoot}/*.json",
        "{projectRoot}/*.(c|m)?js",
        "{projectRoot}/src/**/*.(c|m)?tsx?",
        "{projectRoot}/src/**/*.json"
      ]
    },
    "eslint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "eslint . --color"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "fix": {
          "fix": true
        }
      },
      "cache": true,
      "inputs": [
        "eslint-input",
        "ts-source",
        "^ts-output"
      ],
      "outputs": [],
      "dependsOn": [
        "check:_"
      ]
    },
    "barrelify": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "barrel"
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "prepare:_"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/index.(c|m)?ts"
      ],
      "outputs": [
        "{projectRoot}/**/index.(c|m)?ts"
      ]
    },
    "update-ts-references": {
      "executor": "nx:noop",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": [
        "prepare:_"
      ]
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf ./dist",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths --only '**/*.ts?(x)'",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths --only '**/*.mts?(x)' --out-file-extension mjs",
          "swc ./src -d ./dist --config-file $NX_WORKSPACE_ROOT/configs/swcrc.jsonc --strip-leading-paths -C module.type=commonjs -C module.ignoreDynamic=true -C module.exportInteropAnnotation=true --only '**/*.cts?(x)' --out-file-extension cjs",
          "tsc"
        ],
        "parallel": false,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "build:_"
      ]
    },
    "populate-files": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "load-populate-files --filePath ./dist/file-content.js --target-dir ./out --clean"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output"
      ],
      "outputs": [
        "{projectRoot}/out"
      ],
      "dependsOn": [
        "build:run"
      ]
    },
    "mocha-unit-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none mocha --recursive \"$PWD/dist/tests/unit/**/*.spec.*js\""
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/unit"
      ],
      "dependsOn": [
        "test:_"
      ]
    },
    "mocha-integration-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/integration --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none mocha --recursive \"$PWD/dist/tests/integration/**/*.spec.*js\""
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/integration"
      ],
      "dependsOn": [
        "mocha-unit-test",
        "test:_"
      ]
    },
    "vitest-unit-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf $NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit && NODE_OPTIONS=--enable-source-maps c8 --temp-directory=$NX_WORKSPACE_ROOT/.coverage/project/{projectName}/tmp/unit --src=$NX_WORKSPACE_ROOT --clean=false --reporter=none vitest run --config $NX_WORKSPACE_ROOT/configs/vitest.config.js --root ."
        ],
        "parallel": true,
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output",
        "{workspaceRoot}/configs/vitest.config.js"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/tmp/unit"
      ],
      "dependsOn": [
        "test:_"
      ]
    },
    "coverage-report": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "${NX_WORKSPACE_ROOT}/scripts/nx/coverage-report.sh"
        ],
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "ts-source",
        "^ts-output",
        "{workspaceRoot}/scripts/nx/coverage-report.sh"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage/project/{projectName}/report"
      ],
      "dependsOn": [
        "test:run"
      ]
    },
    "install:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "install": {
      "executor": "nx:noop",
      "dependsOn": [
        "install:_"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "prepare:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "install"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "prepare:generate": {
      "executor": "nx:noop",
      "dependsOn": [
        "prepare:_",
        "barrelify",
        "update-ts-references"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "prepare:format": {
      "executor": "nx:noop",
      "dependsOn": [
        "prepare:generate",
        "biome"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "prepare": {
      "executor": "nx:noop",
      "dependsOn": [
        "prepare:format"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "check:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "prepare"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "check:lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "check:_",
        "eslint"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "check:lint"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "build:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "prepare"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "build:run": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:_",
        "tsc"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "build:post": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:run",
        "populate-files"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:post"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "test:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "build"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "test:run": {
      "executor": "nx:noop",
      "dependsOn": [
        "test:_",
        "mocha-unit-test",
        "mocha-integration-test",
        "vitest-unit-test"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "test:report": {
      "executor": "nx:noop",
      "dependsOn": [
        "test:run",
        "coverage-report"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test:report"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "verify:_": {
      "executor": "nx:noop",
      "dependsOn": [
        "check",
        "test"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "verify:_"
      ],
      "configurations": {
        "__lifecycle": {}
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    }
  ],
  "analytics": false
}
