{
  "$schema": "../../leyman/main/node_modules/nx/schemas/project-schema.json",
  "name": "@leyman/e2e-published-entrypoints",
  "targets": {
    "biome": {},
    "eslint": {
      "inputs": [
        "eslint-input",
        "ts-source",
        "{projectRoot}/test/**/*",
        "package-files",
        "dependency-builds",
        "^dependency-files",
        "{projectRoot}/scripts/**/*"
      ]
    },
    "tsc-test": {},
    "mocha-integration-test": {
      "inputs": [
        "test-source",
        "^dependency-files",
        "{workspaceRoot}/apps/**/package.json",
        "{workspaceRoot}/leyman/**/package.json",
        "{workspaceRoot}/tools/**/package.json"
      ]
    },
    "floor-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/floor-test.mjs",
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "tsc-test"
      ]
    },
    "floor-suites": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/floor-suites.mjs",
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "^tsc-test"
      ]
    },
    "floor-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/floor-types.mjs",
        "color": true,
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "install:_": {},
    "install": {},
    "prepare:_": {},
    "prepare:generate": {},
    "prepare:format": {},
    "prepare": {},
    "check:_": {},
    "check:lint": {},
    "check": {},
    "build:_": {},
    "build:run": {},
    "build:post": {},
    "build:sync": {},
    "build": {},
    "test:_": {},
    "test:compile": {},
    "test:run": {},
    "test:report": {},
    "test": {},
    "verify:_": {},
    "verify": {}
  }
}
