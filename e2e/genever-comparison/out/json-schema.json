{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "tree": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tree"
          }
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "nullable": {
      "type": [
        "string",
        "null"
      ]
    },
    "mixed": {
      "enum": [
        "a",
        42,
        null
      ]
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "square"
            },
            "side": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "side"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tree": {
      "$ref": "#/$defs/tree"
    },
    "headers": {
      "type": "object",
      "patternProperties": {
        "^x-": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^usr_"
    },
    "billing": {
      "type": "object",
      "properties": {
        "card": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "dependentRequired": {
        "card": [
          "address"
        ]
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
